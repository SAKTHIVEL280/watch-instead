    <!-- Privacy -->
    <string name="privacy_body">Lockin has no accounts, ads or analytics, and we run no servers.\n\nYour saved links, notes and settings stay on this device and are not included in cloud backups. Uninstalling Lockin deletes them.\n\nThe accessibility service detects when an app on your guarded list comes to the foreground, so Lockin can show a saved video. It does not read screen content, typed text, messages or passwords. This information is used only on your device and is never collected or shared.\n\nWhen you save a link, Lockin requests its title and thumbnail. For YouTube and TikTok links the request goes to that service\'s public embed endpoint, and for other links it goes to the linked website. Thumbnails are then loaded from the address that service provides. These services receive the link and your IP address, as with any web request.\n\nOpening a saved video hands it to the matching app or your browser, whose own privacy terms apply.</string>

    <!-- Onboarding -->
    <string name="onboarding_welcome_title">Save it now.\nActually watch it.</string>
    <string name="onboarding_welcome_body">You save the videos that fire you up, then forget them and keep scrolling. Lockin brings them back the moment you open a distracting app.</string>
    <string name="onboarding_get_started">Get started</string>
    <string name="onboarding_videos_title">Add your first videos</string>
    <string name="onboarding_videos_body">Add at least %1$d so Lockin has something to show you. %2$d is even better. You can paste links here, or share videos to Lockin from Instagram, TikTok or YouTube.</string>
    <string name="onboarding_videos_progress">%1$d of %2$d videos added</string>
    <string name="onboarding_videos_needed">Add at least %d videos to continue</string>
    <string name="onboarding_apps_title">Which apps pull you in?</string>
    <string name="onboarding_apps_body">Lockin will step in when you open these. You can change them later.</string>
    <string name="onboarding_apps_needed">Choose at least one app to continue</string>
    <string name="onboarding_permission_title">How Lockin uses Accessibility</string>
    <string name="onboarding_permission_body">Android needs you to turn on Lockin\'s accessibility service.</string>
    <string name="onboarding_disclosure_what">What it accesses: only which app is opening, and only for the apps you chose.</string>
    <string name="onboarding_disclosure_why">Why: so Lockin can show a saved video the moment you open one.</string>
    <string name="onboarding_disclosure_never">What it never does: read your screen, messages, typing or passwords.</string>
    <string name="onboarding_disclosure_local">Your data: this stays on your device and is never collected or shared.</string>
    <string name="onboarding_agree">Agree and open settings</string>
    <string name="onboarding_not_now">Not now</string>
    <string name="onboarding_permission_granted">Protection is on. You\'re locked in.</string>
    <string name="onboarding_finish">Finish</string>
    <string name="onboarding_help_title">Can\'t turn it on?</string>
    <string name="onboarding_help_body">If Android says the setting is restricted (common for apps not installed from Play): open Settings, then Apps, then Lockin, tap the ⋮ menu, choose Allow restricted settings, and try again.\n\nIf protection keeps switching off, set Lockin\'s battery usage to Unrestricted in its app settings. Some phone brands stop background services aggressively.</string>
