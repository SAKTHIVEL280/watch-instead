    <!-- Onboarding -->
    <string name="onboarding_welcome_title">Save it now.\nActually watch it.</string>
    <string name="onboarding_welcome_body">You save the videos that fire you up, then forget them and keep scrolling. Watch Instead brings them back the moment you open a distracting app.</string>
    <string name="onboarding_get_started">Get started</string>
    <string name="onboarding_videos_title">Add your first videos</string>
    <string name="onboarding_videos_body">Add at least %1$d so Watch Instead has something to show you. %2$d is even better. You can paste links here, or share videos to Watch Instead from Instagram, TikTok or YouTube.</string>
    <string name="onboarding_videos_progress">%1$d of %2$d videos added</string>
    <string name="onboarding_videos_needed">Add at least %d videos to continue</string>
    <string name="onboarding_apps_title">Which apps pull you in?</string>
    <string name="onboarding_apps_body">Watch Instead will step in when you open these. You can change them later.</string>
    <string name="onboarding_apps_needed">Choose at least one app to continue</string>
    <string name="onboarding_permission_title">How Watch Instead uses Accessibility</string>
    <string name="onboarding_permission_body">Android needs you to turn on Watch Instead\'s accessibility service.</string>
    <string name="onboarding_disclosure_what">What it accesses: only which app is opening, and only for the apps you chose. If you set no cooldown or a focus schedule, it also notices when you return to your home screen.</string>
    <string name="onboarding_disclosure_why">Why: so Watch Instead can show a saved video the moment you open one.</string>
    <string name="onboarding_disclosure_never">What it never does: read your screen, messages, typing or passwords.</string>
    <string name="onboarding_disclosure_local">Your data: this stays on your device and is never collected or shared.</string>
    <string name="onboarding_agree">Agree and open settings</string>
    <string name="onboarding_not_now">Not now</string>
    <string name="onboarding_permission_granted">Protection is on. You\'re all set.</string>
    <string name="onboarding_finish">Finish</string>
    <string name="onboarding_help_title">Can\'t turn it on?</string>
    <string name="onboarding_help_body">If Android says the setting is restricted (common for apps not installed from Play): open Settings, then Apps, then Watch Instead, tap the ⋮ menu, choose Allow restricted settings, and try again.\n\nIf protection keeps switching off, set Watch Instead\'s battery usage to Unrestricted in its app settings. Some phone brands stop background services aggressively.</string>
